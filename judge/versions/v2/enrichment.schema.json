{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cred.nyc/v2/enrichment.schema.json",
  "title": "NYC C.R.E.D. v2 enrichment pass output",
  "description": "Loaded by a batched (function, module) enrichment pass alongside its module. Classifies the raw spans discovery returned. Not loaded by a discovery lens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework_version",
    "document_id",
    "function",
    "module_id",
    "candidates"
  ],
  "properties": {
    "framework_version": {
      "const": "v2"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "function": {
      "$ref": "discovery.schema.json#/$defs/function"
    },
    "module_id": {
      "enum": [
        "ESTATE_IDENTITY",
        "SECURED_FINANCE",
        "LAND_RIGHTS",
        "PUBLIC_PHYSICAL",
        "ECONOMICS",
        "NOTICE_AUTHORITY",
        "GENERIC_GAP"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "quantity_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quantity_candidate"
      }
    },
    "party_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party_candidate"
      }
    },
    "framework_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/framework_gap"
      }
    }
  },
  "$defs": {
    "support": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "evidence_ids"
          ],
          "properties": {
            "kind": {
              "const": "QUOTE"
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rule_id",
            "inputs"
          ],
          "properties": {
            "kind": {
              "const": "RULE"
            },
            "rule_id": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "typed_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reason"
      ],
      "properties": {
        "value": {
          "const": "UNKNOWN"
        },
        "reason": {
          "enum": [
            "NOT_STATED",
            "ILLEGIBLE",
            "CONFLICT",
            "UNALLOCATABLE",
            "UNSUPPORTED_BBL",
            "UNSUPPORTED_DATE",
            "VALID_TIME_PRESENT_BUT_UNNORMALIZABLE",
            "INCORPORATED_SECTION_NOT_SUPPLIED",
            "NOT_CHECKABLE"
          ]
        }
      }
    },
    "interval": {
      "description": "One shape for applicable, asserted-valid, occurrence, and boundary intervals. UNKNOWN omits interval keys.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "UNKNOWN",
            "CONDITION_DEPENDENT"
          ]
        },
        "interval_start": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "interval_end": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "precision": {
          "enum": [
            "DAY",
            "MONTH",
            "YEAR"
          ]
        },
        "basis": {
          "enum": [
            "EXPLICIT_EFFECTIVE",
            "INSTRUMENT_DATE",
            "COMPLETION_OF_REQUIRED_EXECUTION",
            "EXECUTION_DATE",
            "ACKNOWLEDGED_EXECUTION",
            "UNSUPPORTED",
            "EXPRESS_AS_OF",
            "INSPECTION_DATE",
            "SURVEY_DATE",
            "VALUATION_DATE",
            "FORM_LABEL_DIRECTED",
            "STATEMENT_MADE_DATE",
            "FORM_LEVEL_PREPARATION"
          ]
        },
        "reason": {
          "type": "string"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUPPORTED"
              }
            }
          },
          "then": {
            "required": [
              "interval_start",
              "interval_end",
              "precision",
              "basis",
              "support"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "interval_start"
                  ]
                },
                {
                  "required": [
                    "interval_end"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_ids",
        "function",
        "epistemic_character",
        "mode",
        "state_object_key",
        "support"
      ],
      "properties": {
        "anchor_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "function": {
          "$ref": "discovery.schema.json#/$defs/function"
        },
        "epistemic_character": {
          "enum": [
            "TRANSACTION",
            "OBSERVATION",
            "NOTICE"
          ]
        },
        "mode": {
          "enum": [
            "CREATE",
            "MODIFY",
            "TRANSFER",
            "TERMINATE",
            "ASSERT",
            "CORRECT"
          ]
        },
        "would_be_mode": {
          "enum": [
            "CREATE",
            "MODIFY",
            "TRANSFER",
            "TERMINATE",
            "ASSERT",
            "CORRECT"
          ]
        },
        "state_object_key": {
          "type": "string",
          "minLength": 1
        },
        "object_type": {
          "type": "string",
          "minLength": 1
        },
        "interest_kind": {
          "enum": [
            "FEE",
            "CONDOMINIUM_UNIT",
            "COMMON_INTEREST",
            "LIFE_ESTATE",
            "REMAINDER",
            "LEASEHOLD",
            "SUBLEASEHOLD",
            "UNDIVIDED_SHARE",
            "OTHER_NAMED"
          ]
        },
        "applicable_time": {
          "$ref": "#/$defs/interval"
        },
        "asserted_valid_time": {
          "$ref": "#/$defs/interval"
        },
        "unplaced_reason": {
          "enum": [
            "NO_VALID_TIME_STATED",
            "VALID_TIME_PRESENT_BUT_UNNORMALIZABLE",
            "CONDITION_DEPENDENT",
            "UNSUPPORTED_DATE"
          ]
        },
        "parcel_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parcel_binding"
          }
        },
        "module_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger_raw",
            "consequence_raw",
            "status"
          ],
          "properties": {
            "trigger_raw": {
              "type": "string"
            },
            "consequence_raw": {
              "type": "string"
            },
            "status": {
              "enum": [
                "NOT_STATED_TO_HAVE_OCCURRED",
                "STATED_OCCURRED"
              ]
            },
            "changes_emitted_path": {
              "type": "boolean"
            }
          }
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "function": {
                "const": "TITLE"
              }
            }
          },
          "then": {
            "required": [
              "interest_kind"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "epistemic_character": {
                "const": "TRANSACTION"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "asserted_valid_time"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "epistemic_character": {
                "const": "OBSERVATION"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "applicable_time"
              ]
            }
          }
        }
      ]
    },
    "parcel_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbl",
        "scope",
        "roles"
      ],
      "description": "An event may bind many parcels at different scopes. Never a scalar.",
      "properties": {
        "bbl": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[1-5][0-9]{9}$"
            },
            {
              "$ref": "#/$defs/typed_unknown"
            }
          ]
        },
        "scope": {
          "enum": [
            "ENTIRE_BBL",
            "PARTIAL_BBL",
            "UNIT",
            "AIR_SPACE",
            "SUBTERRANEAN_SPACE",
            "FACADE",
            "EASEMENT_AREA",
            "DESCRIBED_PREMISES",
            "UNKNOWN"
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SUBJECT",
              "GRANTING",
              "RECEIVING",
              "BURDENED",
              "BENEFITED",
              "SERVIENT",
              "DOMINANT",
              "COLLATERAL_LOCATION",
              "DECLARED_COMPONENT",
              "UNIT_APPURTENANT"
            ]
          }
        },
        "share_raw": {
          "type": "string"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "module_path": {
      "$ref": "#/$defs/term",
      "description": "Retained name; a bare module path is a term. Deltas use field_op, observation payloads use assertion."
    },
    "quantity_candidate": {
      "allOf": [
        {
          "$ref": "#/$defs/quantity_base"
        }
      ],
      "unevaluatedProperties": false
    },
    "party_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name_raw",
        "support"
      ],
      "properties": {
        "name_raw": {
          "type": "string",
          "minLength": 1
        },
        "role_raw": {
          "type": "string"
        },
        "module_role": {
          "type": "string"
        },
        "capacity_raw": {
          "type": "string"
        },
        "share_raw": {
          "type": "string"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "framework_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_ids",
        "verb_object_raw",
        "candidate_functions",
        "required_path",
        "failure_scope"
      ],
      "properties": {
        "anchor_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verb_object_raw": {
          "type": "string",
          "minLength": 1
        },
        "candidate_functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "discovery.schema.json#/$defs/function"
          }
        },
        "required_path": {
          "type": "string",
          "minLength": 1
        },
        "failure_scope": {
          "enum": [
            "DOCUMENT",
            "REGISTRATION_PATH",
            "SECTION",
            "EVENT_GROUP",
            "EVENT",
            "FIELD"
          ]
        }
      }
    },
    "quantity_base": {
      "type": "object",
      "required": [
        "kind",
        "label_raw",
        "value_raw",
        "scope",
        "allocation_status",
        "support"
      ],
      "properties": {
        "kind": {
          "enum": [
            "NOMINAL_CONSIDERATION",
            "FULL_SALE_PRICE",
            "ASSESSED_VALUE",
            "APPRAISED_VALUE",
            "FAIR_MARKET_VALUE",
            "ORIGINAL_PRINCIPAL",
            "CURRENT_BALANCE",
            "PAYOFF",
            "MAXIMUM_LIEN",
            "CREDIT_LIMIT",
            "NEW_MONEY",
            "RENT",
            "PROJECT_COST",
            "TRANSFER_TAX",
            "MORTGAGE_TAX",
            "RECORDING_FEE",
            "FILING_FEE",
            "OTHER_NAMED_TAX_FEE",
            "DEVELOPMENT_RIGHTS",
            "COMMON_INTEREST",
            "PERCENT_INTEREST",
            "AREA",
            "DIMENSION",
            "DURATION",
            "RATE",
            "OTHER_NAMED"
          ]
        },
        "label_raw": {
          "type": "string",
          "minLength": 1
        },
        "value_raw": {
          "type": "string",
          "minLength": 1
        },
        "value_normalized": {
          "type": "string"
        },
        "currency_or_unit": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "EVENT",
            "STATE_OBJECT",
            "PARCEL",
            "PARTY_SHARE",
            "INSTRUMENT_TOTAL",
            "MULTI_EVENT_TOTAL"
          ]
        },
        "target_event_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_object_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_party_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allocation_status": {
          "enum": [
            "EXPLICIT",
            "DERIVED",
            "NOT_DERIVABLE",
            "NOT_APPLICABLE"
          ]
        },
        "allocation_group_id": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "PARTY_SHARE"
              }
            }
          },
          "then": {
            "required": [
              "target_party_refs"
            ]
          }
        }
      ],
      "description": "Quantity shape without closure; closed at each point of use."
    },
    "field_op": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "value_type",
        "op",
        "support"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "enum": [
            "SCALAR",
            "SET",
            "KEYED_MAP",
            "INTEREST_LEDGER",
            "QUANTITY_ID",
            "PARTY_ID",
            "OBJECT_KEY",
            "RAW_TERM",
            "DISJUNCTIVE_SET",
            "ENUM"
          ]
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "op": {
          "enum": [
            "SET",
            "REMOVE_ASSERTED",
            "NO_CHANGE",
            "UNKNOWN"
          ]
        },
        "value": {
          "not": {
            "type": "null"
          }
        }
      },
      "description": "Transaction and boundary deltas only. Carries a lifecycle-bearing op."
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "value_type",
        "support"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "enum": [
            "SCALAR",
            "SET",
            "KEYED_MAP",
            "INTEREST_LEDGER",
            "QUANTITY_ID",
            "PARTY_ID",
            "OBJECT_KEY",
            "RAW_TERM",
            "DISJUNCTIVE_SET",
            "ENUM"
          ]
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "value": {
          "not": {
            "type": "null"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "asserted_none": {
          "const": true
        }
      },
      "description": "Observation lanes only. Has no op: an observation never performs a lifecycle operation. Express negation sets asserted_none."
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "value_type",
        "support"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "enum": [
            "SCALAR",
            "SET",
            "KEYED_MAP",
            "INTEREST_LEDGER",
            "QUANTITY_ID",
            "PARTY_ID",
            "OBJECT_KEY",
            "RAW_TERM",
            "DISJUNCTIVE_SET",
            "ENUM"
          ]
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "value": {
          "not": {
            "type": "null"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "party_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "object_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Module term record. No op, no lifecycle."
    }
  }
}
